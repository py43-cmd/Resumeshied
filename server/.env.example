# Copy this file to .env and adjust values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Frontend ---
# Comma-separated exact browser origins allowed by CORS.
# Add your production Vercel URL and any preview URLs you need to test.
# No paths, no trailing slashes, no wildcards in production.
CLIENT_ORIGINS=http://localhost:5173

# Single-origin alias kept for older deployments. Ignored when CLIENT_ORIGINS is set.
# CLIENT_ORIGIN=http://localhost:5173

# --- Privacy / temporary processing ---
# Session lifetime in seconds. Files are deleted when it expires.
SESSION_TTL_SECONDS=1800
# Leave empty to use the OS temp directory: <os.tmpdir()>/resumeshield
# On Linux production hosts, /tmp/resumeshield is a good explicit value.
TEMP_ROOT=

# --- Upload limits ---
# 10 MB in bytes. The server enforces this independently of the browser.
MAX_UPLOAD_BYTES=10485760
